<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="520.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="duchess.gui.MainWindow"
            styleClass="app-shell">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <Label text="👑" styleClass="brand-icon" />
            <VBox spacing="2.0">
                <Label text="Duchess" styleClass="brand-title" />
                <Label text="Your personal task companion" styleClass="brand-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="statusLabel" text="✦ Palace ready" styleClass="status-pill status-ready" />
            <Button fx:id="helpButton"
                    mnemonicParsing="false"
                    onAction="#handleHelp"
                    text="💡 Help"
                    styleClass="secondary-button" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="quick-actions"
              AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="82.0">
            <Label text="QUICK COMMANDS" styleClass="section-caption" />
            <Button mnemonicParsing="false" onAction="#handleList" text="📋 View list" styleClass="quick-button" />
            <Button mnemonicParsing="false" onAction="#handleTodo" text="➕ Add todo" styleClass="quick-button" />
            <Button mnemonicParsing="false" onAction="#handleFind" text="🔎 Find" styleClass="quick-button" />
        </HBox>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vvalue="1.0"
                    styleClass="conversation-scroll"
                    AnchorPane.bottomAnchor="78.0"
                    AnchorPane.leftAnchor="16.0"
                    AnchorPane.rightAnchor="16.0"
                    AnchorPane.topAnchor="132.0">
            <content>
                <VBox fx:id="dialogContainer" alignment="TOP_CENTER" prefWidth="488.0" spacing="4.0" />
            </content>
        </ScrollPane>
        <HBox alignment="CENTER" spacing="10.0" styleClass="composer"
              AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0">
            <TextField fx:id="userInput"
                       onAction="#handleUserInput"
                       promptText="Try “todo read book” or “help”"
                       HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton"
                    mnemonicParsing="false"
                    onAction="#handleUserInput"
                    text="Send  ➤"
                    styleClass="primary-button" />
        </HBox>
    </children>
</AnchorPane>
