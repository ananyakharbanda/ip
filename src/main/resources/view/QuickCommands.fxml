<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>

<fx:root alignment="CENTER_LEFT" hgap="8.0" vgap="8.0" styleClass="quick-actions"
         type="javafx.scene.layout.FlowPane"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label text="SQUAD SHORTCUTS" styleClass="section-caption" />
        <Button mnemonicParsing="false" onAction="#handleList"
                text="📋 Check roster" styleClass="quick-button" />
        <Button mnemonicParsing="false" onAction="#handleTodo"
                text="➕ New case" styleClass="quick-button" />
        <Button mnemonicParsing="false" onAction="#handleFind"
                text="🔎 Find clue" styleClass="quick-button" />
    </children>
</fx:root>
