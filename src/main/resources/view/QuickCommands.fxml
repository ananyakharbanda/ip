<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="CENTER_LEFT" spacing="8.0" styleClass="quick-actions"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label text="QUICK COMMANDS" styleClass="section-caption" />
        <Button mnemonicParsing="false" onAction="#handleList"
                text="📋 View list" styleClass="quick-button" />
        <Button mnemonicParsing="false" onAction="#handleTodo"
                text="➕ Add todo" styleClass="quick-button" />
        <Button mnemonicParsing="false" onAction="#handleFind"
                text="🔎 Find" styleClass="quick-button" />
    </children>
</fx:root>
